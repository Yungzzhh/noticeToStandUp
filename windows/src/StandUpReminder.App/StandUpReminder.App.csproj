<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>StandUpReminder</AssemblyName>
    <RootNamespace>StandUpReminder.App</RootNamespace>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.2</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\AppIcon.ico" LogicalName="StandUpReminder.AppIcon.ico" />
    <ProjectReference Include="..\StandUpReminder.Core\StandUpReminder.Core.csproj" />
  </ItemGroup>
</Project>
